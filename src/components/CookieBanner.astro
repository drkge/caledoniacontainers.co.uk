---
// Small, non-blocking cookie notice. Google Analytics runs in consent mode with
// analytics cookies denied until the visitor accepts here (see BaseHead.astro).
// The choice is kept in localStorage; any element with data-cookie-settings reopens it.
---

<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Cookie choice" hidden>
  <p>
    We'd like to use Google Analytics cookies to see how this site is used.
    <a href="/privacy/">Privacy</a>
  </p>
  <div class="cookie-actions">
    <button type="button" class="cookie-accept" data-consent="granted">Accept</button>
    <button type="button" class="cookie-decline" data-consent="denied">No thanks</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "cookie-consent";
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;

    function stored() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }

    // Remove Google Analytics cookies left from an earlier "Accept".
    function clearAnalyticsCookies() {
      var host = location.hostname;
      document.cookie.split(";").forEach(function (cookie) {
        var name = cookie.split("=")[0].trim();
        if (name !== "_ga" && name.indexOf("_ga_") !== 0) return;
        [host, "." + host].forEach(function (domain) {
          document.cookie = name + "=; Max-Age=0; path=/; domain=" + domain;
        });
      });
    }

    function choose(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      if (window.gtag) window.gtag("consent", "update", { analytics_storage: value });
      if (value === "denied") clearAnalyticsCookies();
      banner.hidden = true;
    }

    banner.querySelectorAll("[data-consent]").forEach(function (button) {
      button.addEventListener("click", function () { choose(button.getAttribute("data-consent")); });
    });
    document.querySelectorAll("[data-cookie-settings]").forEach(function (link) {
      link.addEventListener("click", function (event) {
        event.preventDefault();
        banner.hidden = false;
        banner.querySelector("button").focus();
      });
    });

    if (!stored()) banner.hidden = false;
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    z-index: 60;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 22rem;
    padding: 0.875rem 1rem;
    background: #fff;
    color: #161b20;
    border: 1px solid #dde1e5;
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner a {
    color: #c9321b;
    text-decoration: underline;
  }
  .cookie-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.625rem;
  }
  .cookie-actions button {
    padding: 0.4rem 0.9rem;
    border: 1px solid #c9321b;
    border-radius: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .cookie-actions .cookie-accept {
    background: #c9321b;
    color: #fff;
  }
  .cookie-actions .cookie-decline {
    background: #fff;
    color: #161b20;
    border-color: #dde1e5;
  }
  .cookie-actions button:hover {
    filter: brightness(0.94);
  }
</style>
