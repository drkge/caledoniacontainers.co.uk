---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
// Preload only the faces used above the fold. Vite hashes these to the same
// URLs the fontsource @font-face rules reference, so nothing downloads twice.
import displayBold from "@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url";
import textRegular from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";
import textSemibold from "@fontsource/barlow/files/barlow-latin-600-normal.woff2?url";
import { SITE_TITLE, SITE_DESCRIPTION, OG_IMAGE, BUSINESS } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Extra JSON-LD nodes for this page (Service, LocalBusiness, breadcrumbs...). */
  schema?: Record<string, any>[];
  /** Keep a page out of the index (used by 404). */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = OG_IMAGE.src,
  schema = [],
  noindex = false,
} = Astro.props;

// Pages that already say the brand name keep their title verbatim; everything
// else gets the site name appended.
const pageTitle = title.includes(SITE_TITLE)
  ? title
  : `${title} | ${SITE_TITLE}`;

// Build these off `Astro.site` rather than `Astro.url`, so the deployed origin
// is always the canonical one regardless of where the page is served from.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

const organization = {
  "@type": "Organization",
  "@id": new URL("/#organization", Astro.site).href,
  name: BUSINESS.name,
  legalName: BUSINESS.legalName,
  url: Astro.site?.href,
  email: BUSINESS.email,
  telephone: BUSINESS.telephoneIntl,
  logo: new URL("/favicon/android-chrome-512x512.png", Astro.site).href,
  image: new URL(OG_IMAGE.src, Astro.site).href,
  sameAs: BUSINESS.sameAs,
  address: {
    "@type": "PostalAddress",
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.locality,
    addressRegion: BUSINESS.address.region,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.country,
  },
};

const website = {
  "@type": "WebSite",
  "@id": new URL("/#website", Astro.site).href,
  url: Astro.site?.href,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  inLanguage: "en-GB",
  publisher: { "@id": organization["@id"] },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organization, website, ...schema],
};
---

<!-- Google Analytics (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-BGF2REMFCJ"
></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  // Consent mode: no analytics cookies until the visitor accepts in CookieBanner.astro.
  var cookieConsent = null;
  try { cookieConsent = localStorage.getItem("cookie-consent"); } catch (e) {}
  gtag("consent", "default", {
    analytics_storage: cookieConsent === "granted" ? "granted" : "denied",
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
  });
  gtag("js", new Date());

  gtag("config", "G-BGF2REMFCJ");
</script>

<!-- Microsoft Clarity -->
<script is:inline>
  (function (c, l, a, r, i, t, y) {
    c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
    t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
    y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
  })(window, document, "clarity", "script", "z0tqsfh5rv");
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#E63D24" />

<!-- Font preloads -->
<link rel="preload" href={displayBold} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={textRegular} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={textSemibold} as="font" type="font/woff2" crossorigin />

<!-- Page Title -->
<title>{pageTitle}</title>
<!-- Description & canonical -->
<meta name="description" content={description} />
{
  /* 404.html is served for any missing path, so a self-referencing
     canonical there would point at the wrong URL. */
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <link rel="canonical" href={canonicalURL} />
  )
}
<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/favicon/apple-touch-icon.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/favicon/favicon-32x32.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="16x16"
  href="/favicon/favicon-16x16.png"
/>
<link rel="manifest" href="/favicon/site.webmanifest" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:alt" content={OG_IMAGE.alt} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
